{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/test/tsconfig.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@racing/shared$": "<rootDir>/../../packages/shared/src/index.ts"
  },
  "testTimeout": 30000
}
