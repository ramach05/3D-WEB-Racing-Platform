{
  "name": "@racing/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node -e \"require('node:fs').rmSync('tsconfig.build.tsbuildinfo',{force:true})\" && nest build && nest start --watch",
    "build": "node -e \"require('node:fs').rmSync('tsconfig.build.tsbuildinfo',{force:true})\" && nest build",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --config ./vitest.config.ts",
    "test:unit": "vitest run --config ./vitest.config.ts src",
    "test:e2e": "vitest run --config ./vitest.config.ts test",
    "test:watch": "vitest --config ./vitest.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:setup": "prisma migrate deploy && prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@racing/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
